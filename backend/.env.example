# =============================================================================
# Gestor Milhas API — Environment Variables
# =============================================================================
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o arquivo .env no repositório.
# =============================================================================

# Database
# URL de conexão PostgreSQL para o Prisma (obtida no Supabase Dashboard > Settings > Database)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Application
NODE_ENV=development
PORT=3000

# Auth
JWT_SECRET=your-jwt-secret
JWT_REFRESH_SECRET=your-jwt-refresh-secret

# SMTP (envio de e-mails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
CONTACT_EMAIL=your-email@gmail.com

# Frontend
# URL do frontend em produção (usada em e-mails/redirects)
FRONTEND_URL=http://localhost:5173
# Origem permitida pelo CORS — se vazio, libera qualquer origem (uso em dev)
CORS_ORIGIN=
